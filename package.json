{
  "name": "policy-management-service",
  "version": "1.0.0",
  "description": "Scalable modular Node.js backend for insurance policy management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/db-init.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles"
  },
  "keywords": [
    "fastify",
    "mongodb",
    "insurance",
    "policy",
    "worker-threads"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "mongoose": "^8.5.1",
    "node-schedule": "^2.1.1",
    "os-utils": "^0.0.14",
    "pump": "^3.0.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/env.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  }
}
